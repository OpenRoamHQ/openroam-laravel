{
  "name": "openroam/laravel",
  "type": "library",
  "description": "Laravel integration for the OpenRoam Partner API SDK: a configured client in the container, and webhook signature checking.",
  "keywords": ["openroam", "laravel", "esim", "sdk"],
  "homepage": "https://github.com/OpenRoamHQ/openroam-laravel",
  "license": "MIT",
  "authors": [
    {
      "name": "OpenRoam",
      "email": "support@openroam.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "openroam/sdk": "0.1.0-rc.7"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "OpenRoam\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenRoam\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "OpenRoam\\Laravel\\OpenRoamServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
